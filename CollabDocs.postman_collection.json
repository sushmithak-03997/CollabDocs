        {
          "name": "DEMO: Create workspace - simulated failure (rollback)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Simulate-Failure",
                "value": "true"
              }
            ],
            "url": "{{base_url}}/workspaces/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Doomed Workspace\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requires DEBUG=True. Fails AFTER the workspace row is inserted but BEFORE the admin member is added; atomic block rolls everything back. Verify: GET /workspaces/ shows no 'Doomed Workspace'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
